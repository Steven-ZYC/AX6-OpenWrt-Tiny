# EXPERIMENTAL combined PPE + Tiny Plus firmware for the ORIGINAL Redmi AX6 NAND layout.
# OpenWrt ppe-nss kernel 6.18 (NOT ImmortalWrt 25.12); DO NOT FLASH without hardware verification.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
# CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6 is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024

# Wired Qualcomm EDMA/PPE is provided in the source kernel, not a legacy NSS package.
CONFIG_PACKAGE_ppe-help=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_firewall4=y

# NSS Wi-Fi uses the new in-kernel PPE/EDMA-coexisting driver, NOT the old vendor NSS ECM stack.
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# Minimal PPE tc offload userspace and kernel action support; advanced QoS UI is separate.
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-vlan=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-red=y

# Shared base: LuCI, Chinese language, and Argon theme.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# HomeProxy from ImmortalWrt LuCI, sing-box-tiny from current OpenWrt packages feed.
# Tiny tags are patched with a guarded source-level check to keep uTLS+Clash API,
# but leave out QUIC and gVisor. VLESS Reality and Shadowsocks need runtime tests.
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
# Interactive LuCI Terminal (Plus ONLY). ttyd must require /bin/login.
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
# Plus-only LuCI conveniences: upload/edit files, configure scheduled reboot.
# Backup / Flash Firmware is included via the standard luci-mod-system module.
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_sing-box-tiny=y
# CONFIG_PACKAGE_sing-box is not set
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ca-bundle=y

# Explicitly reject the legacy 5.10 vendor NSS / ECM / Shortcut-FE stack.
# CONFIG_PACKAGE_qca-nss-ecm is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-64 is not set
# CONFIG_PACKAGE_kmod-shortcut-fe is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set

# Redmi AX6 (NOT AX6S / AX6000), original / stock partition layout.
# Reference: ImmortalWrt openwrt-25.12, qualcommax/ipq807x.
# Do NOT enable redmi_ax6 (expanded layout).
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
# CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6 is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024

# Administration and theme: prioritize practical usability over extreme shaving.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# HomeProxy + single, feature-selected sing-box core.
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_sing-box-tiny=y
# CONFIG_PACKAGE_sing-box is not set
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ca-bundle=y

# Required for many VLESS Reality profiles using TLS client fingerprint.
CONFIG_SING_BOX_TINY_BUILD_UTLS=y
# Keep HomeProxy's Clash API status features when supported.
CONFIG_SING_BOX_TINY_BUILD_CLASH_API=y
# Disable optional heavy transports and stacks unless needed.
# CONFIG_SING_BOX_TINY_BUILD_ACME is not set
# CONFIG_SING_BOX_TINY_BUILD_DHCP is not set
# CONFIG_SING_BOX_TINY_BUILD_EMBEDDED_TOR is not set
# CONFIG_SING_BOX_TINY_BUILD_GRPC is not set
# CONFIG_SING_BOX_TINY_BUILD_GVISOR is not set
# CONFIG_SING_BOX_TINY_BUILD_QUIC is not set
# CONFIG_SING_BOX_TINY_BUILD_TAILSCALE is not set
# CONFIG_SING_BOX_TINY_BUILD_V2RAY_API is not set
# CONFIG_SING_BOX_TINY_BUILD_WIREGUARD is not set

# Compiler reuse on GitHub Actions.
CONFIG_CCACHE=y

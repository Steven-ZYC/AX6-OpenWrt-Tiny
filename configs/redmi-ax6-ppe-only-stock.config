# EXPERIMENT ONLY. Redmi AX6 stock layout, PPE datapath, NO NSS Wi-Fi offload.
# Diagnostic base: not feature-parity with the current ImmortalWrt Tiny image.
# Never use this profile as a flashing recommendation before real hardware verification.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
# CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6 is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
# Keep minimal Wi-Fi in the target default packages (ath11k + ipq-wifi-redmi_ax6).
# No HomeProxy, Argon, proxy core, NSS firmware, ECM, or NSS qdisc in this feasibility build.
# CONFIG_PACKAGE_kmod-nss-wifi-drv is not set
# CONFIG_ATH11K_NSS_WIFI is not set
# CONFIG_PACKAGE_qca-nss-ecm is not set
